{
  "name": "fit4110-lab03-postman-mock-testing",
  "version": "1.0.0",
  "description": "Smart Campus Postman Contract and Mock Testing Project Solution",
  "main": "index.js",
  "scripts": {
    "lint": "npx @stoplight/spectral-cli lint contracts/*.yaml",
    "mock:iot": "npx prism mock contracts/iot-ingestion.openapi.yaml -p 4010",
    "mock:vision": "npx prism mock contracts/ai-vision.openapi.yaml -p 4010",
    "test:mock": "npx newman run postman/collections/FIT4110_lab03_iot_ingestion.postman_collection.json -e postman/environments/FIT4110_lab03_mock.postman_environment.json -r cli"
  },
  "dependencies": {
    "@stoplight/spectral-cli": "^6.11.0",
    "newman": "^6.1.3",
    "wait-on": "^7.2.0"
  }
}