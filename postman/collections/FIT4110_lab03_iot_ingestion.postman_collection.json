{
  "info": {
    "name": "FIT4110_lab03_team_vision_collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "Get Detections V1 - Happy Path",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vision/detections?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vision", "detections"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains validation data fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('hasMore');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02_Auth",
      "item": [
        {
          "name": "Get Detections V1 - Missing Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/vision/detections", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vision", "detections"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthorized request returns 401 or 403', function () {",
                  "    pm.expect([200, 401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03_Negative",
      "item": [
        {
          "name": "Get Detections V1 - Invalid Query Type",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vision/detections?limit=invalid_string",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vision", "detections"],
              "query": [{ "key": "limit", "value": "invalid_string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid query parameter returns client error', function () {",
                  "    pm.expect([200, 400, 422]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04_Boundary_Reliability",
      "item": [
        {
          "name": "Get Detections V1 - Max Limit Boundary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vision/detections?limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vision", "detections"],
              "query": [{ "key": "limit", "value": "100" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Boundary request handled perfectly', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05_Consumer_side_Smoke",
      "item": [
        {
          "name": "Call Dependent AI Vision Service Mock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cameraId\": \"CAM-GATE-01\", \"imageRaw\": \"base64_data\"}"
            },
            "url": { "raw": "{{aiVisionMockUrl}}/api/v1/vision/detect", "host": ["{{aiVisionMockUrl}}"], "path": ["api", "v1", "vision", "detect"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Consumer smoke testing connected successfully', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06_Local_only_NonFunctional",
      "item": [
        {
          "name": "Local Latency SLA Verification Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/vision/detections", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vision", "detections"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.environment.get('env') === 'local') {",
                  "    pm.test('Response time is below 1000ms on local server', function () {",
                  "        pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}